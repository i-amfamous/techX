# Brevo transactional email — free plan includes 300 emails/day.
# 1. Create a free account at https://www.brevo.com
# 2. Verify the sender address below in Brevo → Senders & domains
# 3. Create an API key with transactional email sending rights
# Only this value is a secret. Mark it "Contains secret values" in Netlify.
BREVO_API_KEY=

# Optional overrides, already defaulted to the studio inbox in the function.
# These are PUBLIC addresses: do not mark them as secrets in Netlify, or the
# secret scanner will find them in the site build and fail the deploy.
BREVO_SENDER_EMAIL=nganbewuborijaamos@gmail.com
INQUIRY_TO_EMAIL=nganbewuborijaamos@gmail.com
